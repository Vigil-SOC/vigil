    {
      "id": 24,
      "title": "Probe scores by probe / outcome (range)",
      "description": "A series seen in the hour before the range counts its increase; one born inside the range (first score since a daemon start) counts its whole value, since increase() alone drops a counter's first sample. Zero-count outcomes are hidden.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* hit$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* miss$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* silent$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (probe, outcome) ((increase(vigil_probe_results_total{job=\"otel-collector\"}[$__range]) and last_over_time(vigil_probe_results_total{job=\"otel-collector\"}[1h] offset $__range)) or (max_over_time(vigil_probe_results_total{job=\"otel-collector\"}[$__range]) unless last_over_time(vigil_probe_results_total{job=\"otel-collector\"}[1h] offset $__range))) > 0",
          "legendFormat": "{{probe}} {{outcome}}",
          "instant": true
        }
      ]
    },
    {
      "id": 25,
      "title": "Probe mean time to verdict by probe (trailing 1d)",
      "description": "Exact mean from the histogram's _sum/_count, not a p95: at one score per probe per day, histogram_quantile only interpolates inside a default bucket. Mean of the verdicts in the trailing 24h (usually one per probe); silent scores have no verdict and draw no line.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
