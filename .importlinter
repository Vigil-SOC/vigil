; Layering contracts for the clients/ + services/ + core/ + infra/ structure
; (epic #481). CONTEXT.md states these rules in prose; this file is what makes
; them true. They were agreed at R5 and had accumulated 20 counterexamples by
; R9, which is the argument for a gate rather than a convention.
;
; Run locally with:  lint-imports

[importlinter]
root_packages =
    core
    services
    tools

[importlinter:contract:deployables]
name = core is a library: it must not import the deployables
type = forbidden
source_modules =
    core
forbidden_modules =
    services

[importlinter:contract:tiers]
name = the shared-infrastructure tier must not import a capability domain
type = forbidden
source_modules =
    core.storage
    core.platform
forbidden_modules =
    core.agents
    core.api
    core.auth
    core.cases
    core.chat
    core.detections
    core.federation
    core.findings
    core.ingestion
    core.integrations
    core.llm
    core.memory
    core.reporting
    core.response
    core.skills
    core.threat_intel
    core.workflows

[importlinter:contract:versioned-api]
name = the versioned API surface composes the domains; nothing under core imports it back
type = forbidden
source_modules =
    core.agents
    core.auth
    core.cases
    core.chat
    core.detections
    core.federation
    core.findings
    core.ingestion
    core.integrations
    core.llm
    core.memory
    core.reporting
    core.response
    core.skills
    core.threat_intel
    core.workflows
forbidden_modules =
    core.api

[importlinter:contract:ingestion]
name = Federation drives Ingestion, never the reverse
type = forbidden
source_modules =
    core.ingestion
forbidden_modules =
    core.federation

[importlinter:contract:tools]
name = core reaches tools/ at exactly one place, and that place is named here
type = forbidden
source_modules =
    core
forbidden_modules =
    tools
ignore_imports =
    ; Vigil's own MCP server is defined in tools/ and called in this process
    ; rather than spoken to down a pipe. The bridge is the one crossing, and
    ; naming it here is what stops it becoming the precedent for the next one.
    core.integrations.mcp.in_process -> tools.mcp.vigil
