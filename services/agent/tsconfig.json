{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // Checked by tsconfig.rootcause-v3.json instead, under one relaxed flag. Nothing else
  // may be added here: tests/core/tsconfig-exclusions.test.ts holds the list.
  "exclude": ["node_modules", "plugins/rootcause/v3", "tests/rootcause/v3"]
}
