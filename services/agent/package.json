{
  "name": "@vigil/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vigil agent layer: the ledger, the harness, and the workflows that reason with a model",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/core tests/hunt tests/chat",
    "test:integration": "vitest run tests/integration",
    "build": "tsc -p tsconfig.build.json",
    "worker": "tsx worker.ts",
    "serve": "tsx serve.ts",
    "ledger:verify": "tsx ledger/verify.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "bullmq": "5.81.3",
    "openai": "^4.104.0",
    "p-limit": "^6.2.0",
    "pg": "^8.13.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
