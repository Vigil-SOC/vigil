{
  "name": "@vigil/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vigil agent layer: the ledger, the harness, and the workflows that reason with a model",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/core tests/hunt tests/chat",
    "test:integration": "vitest run tests/integration",
    "build": "tsc -p tsconfig.build.json",
    "worker": "tsx worker.ts",
    "serve": "tsx serve.ts",
    "ledger:verify": "tsx ledger/verify.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "ajv": "^8.20.0",
    "bullmq": "5.81.3",
    "openai": "^7.38.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "^6.4.4"
  }
}
