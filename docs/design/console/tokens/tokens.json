  "type": {
    "families": {
      "ui": "'Plus Jakarta Sans', system-ui, sans-serif",
      "mono": "'Roboto Mono', monospace"
    },
    "monoFor": "IDs, numbers, timestamps, code, counts in chips, keyboard hints",
    "scale": {
      "page-title": "22px / 600",
      "case-title": "20px / 700 / -0.2px",
      "block-title": "18px / 700",
      "section-title": "13px / 650",
      "body": "13px / 400 / 1.5",
      "body-strong": "13.5px / 500",
      "label": "12px / 600",
      "meta": "12px / 400 / tx2",
      "micro": "11.5px",
      "count-chip": "11px mono"
    },
    "rules": [
      "Sentence case everywhere; no uppercase letter-spaced labels",
      "Tabular numerals on",
      "No text below 11px"
    ]
  },
  "radius": {
    "pill-sm": "8px",
    "button": "10px",
    "card-inner": "10px",
    "card": "14px",
    "panel": "12px",
    "round": "999px"
  },
  "control": {
    "button-sm": "28px",
    "button": "36px",
    "tab": "38px",
    "state-pill": "22px",
    "header-row": "52px",
    "nav-row": "46px",
    "search": "38px"
  },
  "space": [
    "4px",
    "6px",
    "8px",
    "10px",
    "12px",
    "14px",
    "16px",
    "18px",
    "20px",
    "24px",
    "28px"
  ],
  "layout": {
    "min-width": "1440px",
    "case-drawer": "75%",
    "case-side-panel": "280px",
    "chat-dock": "400px",
    "command-bar-max": "760px"
  }
}