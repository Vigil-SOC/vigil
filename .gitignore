.mcp.json
index.scip
index.scip.stamp
slop.toml
.zed/

# Bifrost's local gateway state: 81MB of SQLite at the repo root. Anchored --
# an unanchored `bifrost/` also swallows core/llm/bifrost/ and
# infra/docker/bifrost/, both of which are tracked source.
/bifrost/

# Where a file-ledger hunt writes its output. Real run data: sanitise it before it
# goes anywhere near the tree -- services/agent/scripts/sanitise-hunt-ledgers.ts.
# Left unanchored on purpose: a hunt run from services/agent/ writes its ledgers
# there, not at the repo root, and anchoring this to the root stopped ignoring
# them. The sanitised fixtures live under a runs/ too and are committed, so that
# one directory is negated -- git will not descend into an ignored directory, so
# the directory itself has to be unignored, not just the files in it.
runs/
!services/agent/tests/fixtures/runs/

# Editor, build and indexer scratch. All local, none of it ever committed.
.vite/
.zed/
index.scip.stamp

# The gateway's own store, wherever it is launched from: it holds provider API keys,
# in plaintext unless the deployment turned on Bifrost's key encryption.
/config.db
/logs.db
/bifrost/

# Working copies of two dropped submodules, which survive a checkout. Neither has a
# production importer here -- mcp-servers' four servers are vendored at tools/mcp/.
/deeptempo-core/
/mcp-servers/

# Local scratch space -- notes and throwaway files, never committed.
/.scratch/

# Repo-local uv install, created by scripts/lib.sh when the host has no uv.
/.uv/

# Timestamped .env copies left by setup and migration scripts.
.env.*
